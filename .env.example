# Bissabi Home Made Food — copier en .env et remplacer les valeurs YOUR_*.
# Sans ces valeurs, l’app fonctionne en mode local : paiement SIMULÉ, clairement indiqué, aucun débit.
# Une valeur vide ou commençant par YOUR_ est traitée comme absente. Aucune clé réelle dans ce fichier.

# --- Client (publiques, embarquées dans le bundle) ---
# Projet existant bissabi-home-made-food, ref qizhprlzeiqrngwpxjnd, région eu-central-2 (Zurich).
# L’URL n’est pas un secret. La clé anon se copie depuis le tableau de bord, elle ne se commit pas.
EXPO_PUBLIC_SUPABASE_URL=https://qizhprlzeiqrngwpxjnd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Site public à la racine du domaine : EXPO_PUBLIC_WEB_BASE=/
# Sans cette variable, l’export web garde le préfixe GitHub Pages.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
EXPO_PUBLIC_MAPS_KEY=YOUR_MAPS_API_KEY
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
EXPO_PUBLIC_APPLE_MERCHANT_ID=YOUR_APPLE_MERCHANT_ID
EXPO_PUBLIC_PAYMENTS_API_URL=YOUR_PAYMENTS_API_URL
EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
# 1 seulement après validation hygiène, autorités, paiement et sécurité. Sinon : pré-inscription, aucun débit.
EXPO_PUBLIC_LAUNCH_PAYMENTS=

# Build iOS déjà utilisé par Mohamed (TestFlight). Ne pas changer l’équipe ni les identifiants.
# EXPO_NO_CAPABILITY_SYNC=1
# Apple team (eas.json) : Y9XF9RY2BU

# --- SERVEUR UNIQUEMENT — ne JAMAIS préfixer par EXPO_PUBLIC_ (ces variables sont publiques). ---
# SUPABASE_URL=https://qizhprlzeiqrngwpxjnd.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Projet bissabi-crm, ref ppeovmfuhtidavdnrwxu. La clé service ne quitte pas l’environnement de la fonction.
# CRM_SUPABASE_URL=https://ppeovmfuhtidavdnrwxu.supabase.co
# CRM_SERVICE_ROLE_KEY=YOUR_CRM_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
# Secret du endpoint Connect (account.updated, payout.paid, payout.failed), distinct du secret plateforme.
# STRIPE_CONNECT_WEBHOOK_SECRET=YOUR_STRIPE_CONNECT_WEBHOOK_SECRET
# 1 sur les fonctions seulement, après les mêmes validations que le drapeau client.
# LAUNCH_PAYMENTS=
# STRIPE_CONNECT_CLIENT_ID=YOUR_STRIPE_CONNECT_CLIENT_ID
# TWINT_MERCHANT_ID=YOUR_TWINT_MERCHANT_ID
# EXPO_PUSH_ACCESS_TOKEN=YOUR_EXPO_PUSH_TOKEN
# RESEND_API_KEY=YOUR_EMAIL_API_KEY
# ADMIN_EMAILS=YOUR_ADMIN_EMAILS
