# STRIPE_CONNECT_CLIENT_ID=YOUR_STRIPE_CONNECT_CLIENT_ID
# TWINT_MERCHANT_ID=YOUR_TWINT_MERCHANT_ID
# EXPO_PUSH_ACCESS_TOKEN=YOUR_EXPO_PUSH_TOKEN
# RESEND_API_KEY=YOUR_EMAIL_API_KEY
# ADMIN_EMAILS=YOUR_ADMIN_EMAILS
