# Bissabi Home Made Food — copier en .env et remplacer les valeurs YOUR_*.
# Sans ces valeurs, l’app fonctionne en mode local : paiement SIMULÉ, clairement indiqué, aucun débit.
# Une valeur vide ou commençant par YOUR_ est traitée comme absente. Aucune clé réelle dans ce fichier.

# --- Client (publiques, embarquées dans le bundle) ---
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
EXPO_PUBLIC_MAPS_KEY=YOUR_MAPS_API_KEY
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
EXPO_PUBLIC_APPLE_MERCHANT_ID=YOUR_APPLE_MERCHANT_ID
EXPO_PUBLIC_PAYMENTS_API_URL=YOUR_PAYMENTS_API_URL
EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL

# Build iOS déjà utilisé par Mohamed (TestFlight). Ne pas changer l’équipe ni les identifiants.
# EXPO_NO_CAPABILITY_SYNC=1
# Apple team (eas.json) : Y9XF9RY2BU

# --- SERVEUR UNIQUEMENT — ne JAMAIS préfixer par EXPO_PUBLIC_ (ces variables sont publiques). ---
